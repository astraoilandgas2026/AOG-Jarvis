{
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 1,
  "tradable_balance_ratio": 0.10,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 20,
  "db_url": "sqlite:///tradesv3.dryrun.sqlite",
  "cancel_open_orders_on_exit": true,
  "trading_mode": "spot",
  "exchange": {
    "name": "binance"
  },
  "pairlists": [
    {
      "method": "StaticPairList",
      "pairs": ["BTC/USDT", "ETH/USDT", "SOL/USDT"]
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": true,
    "jwt_secret_key": "local-env-required",
    "username": "local-env-required",
    "password": "local-env-required"
  },
  "bot_name": "EMA-Freqtrade",
  "initial_state": "stopped",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
