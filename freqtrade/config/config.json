{
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.05,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 20,
  "db_url": "sqlite:///tradesv3.dryrun.sqlite",
  "cancel_open_orders_on_exit": true,
  "trading_mode": "spot",
  "margin_mode": "isolated",
  "exchange": {
    "name": "binance",
    "key": "${BINANCE_API_KEY}",
    "secret": "${BINANCE_API_SECRET}"
  },
  "pairlists": [{"method":"StaticPairList","pairs":["BTC/USDT","ETH/USDT","SOL/USDT"]}],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": true,
    "jwt_secret_key": "${FREQTRADE_JWT_SECRET}",
    "username": "${FREQTRADE_USERNAME}",
    "password": "${FREQTRADE_PASSWORD}"
  },
  "bot_name": "EMA-Freqtrade",
  "initial_state": "stopped",
  "force_entry_enable": false,
  "internals": {"process_throttle_secs": 5}
}
